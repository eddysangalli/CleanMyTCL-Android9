<?xml version="1.0" encoding="utf-8"?>
<!-- The article reader: the news link rendered inside the launcher, because this TV's browser ignores
     ACTION_VIEW and opens its own home instead. Back leaves; the page fills the screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <WebView
        android:id="@+id/reader"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/readerLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:max="100" />
</FrameLayout>
