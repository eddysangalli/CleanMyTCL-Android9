<?xml version="1.0" encoding="utf-8"?>
<!-- The full-screen news (NewsFullActivity): today's front page, one headline at a time over its
     own photo. The scrim keeps the text readable whatever the picture behind it is doing. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fullRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <ImageView
        android:id="@+id/fullPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Bottom-up dark gradient: the headline sits on the darkest part, over any photo. -->
    <View
        android:id="@+id/fullScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/news_full_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingEnd="96dp"
        android:paddingBottom="88dp">

        <TextView
            android:id="@+id/fullKicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFE6A800"
            android:textSize="16sp"
            android:letterSpacing="0.16"
            android:textAllCaps="true"
            android:fontFamily="@font/outfit_medium" />

        <TextView
            android:id="@+id/fullTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:maxLines="4"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="44sp"
            android:lineSpacingExtra="6dp"
            android:fontFamily="@font/outfit_light" />

        <TextView
            android:id="@+id/fullAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/outfit_medium" />

        <!-- One dot per headline, the current one bright; filled in by markDot. -->
        <LinearLayout
            android:id="@+id/fullDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
