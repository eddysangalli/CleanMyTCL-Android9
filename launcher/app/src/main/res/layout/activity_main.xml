<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- No background: the window is already black (Theme.TvHome), a second full-screen fill only costs GPU time. -->

    <!-- Static wallpaper. Decoded on a worker thread at RGB_565 and hidden in ultralight mode; no blur,
         parallax or animation is computed on the TV. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:focusable="false"
        android:clickable="false"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Eddy TV header: brand row (name, clock, date, optional weather), greeting, message. -->
            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/brand"
                        style="@style/BrandText"
                        android:fontFamily="@font/outfit_bold" />

                    <TextClock
                        android:id="@+id/clock"
                        style="@style/BrandText"
                        android:layout_marginStart="16dp"
                        android:format12Hour="h:mm a"
                        android:format24Hour="HH:mm"
                        android:textColor="#E6FFFFFF" />

                    <TextClock
                        android:id="@+id/date"
                        style="@style/BrandText"
                        android:layout_marginStart="16dp"
                        android:format12Hour="@string/date_format"
                        android:format24Hour="@string/date_format" />

                    <TextView
                        android:id="@+id/weather"
                        style="@style/BrandText"
                        android:layout_marginStart="16dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="390dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="42sp"
                    android:fontFamily="@font/outfit_light"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="30sp"
                    android:autoSizeMaxTextSize="42sp"
                    android:autoSizeStepGranularity="2sp" />
            </LinearLayout>

            <!-- Outside leftBlock so a message that wraps to a second line does not push the pills down. -->
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/leftBlock"
                android:layout_alignParentStart="true"
                android:layout_marginStart="2dp"
                android:layout_marginTop="8dp"
                android:maxWidth="390dp"
                android:textColor="#99FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_regular"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Fixed offset from the top, where the pills sat when they followed a one-line header, so
                 neither the greeting's auto-size nor a two-line message moves them. -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="53dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <!-- Icon only: opens the existing Google Assistant (ACTION_ASSIST), no second listener. -->
                <TextView
                    android:id="@+id/btnVoice"
                    style="@style/TopButton"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:drawablePadding="0dp"
                    android:drawableStart="@drawable/ic_mic"
                    android:contentDescription="@string/voice"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <FrameLayout
            android:id="@+id/newsCarousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:visibility="gone">

            <com.gathin.tvhome.NewsBackdropView
                android:id="@+id/newsBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <!-- Full-bleed fade so the words stay readable on a bright photo without a panel. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/news_text_scrim"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/newsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="150dp"
                android:layout_marginBottom="34dp"
                android:orientation="vertical"
                android:importantForAccessibility="no">

                <TextView
                    android:id="@+id/newsKicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.14" />

                <TextView
                    android:id="@+id/newsHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="#FFFFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="@font/outfit_light"
                    android:letterSpacing="-0.01"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/newsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="#B8FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_light" />

                <TextView
                    android:id="@+id/newsMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/newsDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="40dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:importantForAccessibility="no" />
        </FrameLayout>


        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:focusedByDefault="true"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
