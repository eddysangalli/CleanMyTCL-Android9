<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration for the TCL BeyondTV2 (Android TV 9). Edit, then rebuild.
  Package names come from backup/<data>/packages_installed.txt.
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.globo.globotv</item>
        <item>com.spotify.tv.android</item>
    </string-array>

    <!-- Apps never shown as tiles: the Live TV app is in the Inputs menu, Settings has its own button. -->
    <string-array name="hidden_apps">
        <item>com.tcl.tv</item>
        <item>com.android.tv.settings</item>
    </string-array>

    <!-- The TV's Live TV / tuner app (opens HDMI, AV and antenna: com.tcl.tv/.TVActivity). -->
    <string name="live_tv_package" translatable="false">com.tcl.tv</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. Tiles are 180dp wide at 4 columns and
         shrink to fit from 5 up (about 144dp at 5, 117dp at 6 on a 1080p TV). -->
    <integer name="columns">4</integer>
</resources>
