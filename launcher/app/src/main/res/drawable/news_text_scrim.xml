<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed fade over the news photo: transparent at the top, dark at the bottom. It covers the whole
     carousel (no margins), so the words are readable without drawing a panel with visible edges.
     Darker than the first attempt: the kicker and the summary sit over the middle of the ramp, and at
     40% black the photo still won the contrast fight on a bright picture. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#00000000"
        android:centerColor="#99000000"
        android:endColor="#FF000000"
        android:type="linear" />
</shape>
